# Copy to .env for local development against Supabase (optional — without
# DATABASE_URL the app uses a local embedded database in data/pglite).
# On Vercel, set these in Project → Settings → Environment Variables.

# Supabase → Connect → "Transaction pooler" connection string (port 6543)
DATABASE_URL=

# Any long random string; signs login sessions. Changing it logs everyone out.
AUTH_SECRET=

# Supabase → Project Settings → API (for ticket photos)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp alerts for new / assigned tickets (server/whatsapp.ts). Leave
# WHATSAPP_PROVIDER empty to only print the messages in the server console.
#   twilio → TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_FROM (+ optional TWILIO_CONTENT_SID template)
#   meta   → WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID (+ optional WHATSAPP_TEMPLATE, WHATSAPP_TEMPLATE_LANG)
#   web    → free: sends from one WhatsApp number linked by QR code (Réglages). Run `npm run whatsapp` next to the
#            app (it reads this file: APP_URL + the same secret). WHATSAPP_GATEWAY_URL = its address, to wake it.
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=fr
# Public address of the app, added at the end of each WhatsApp message (optional)
APP_URL=
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_SECRET=
